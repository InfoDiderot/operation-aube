; Opération Aube — prototype FPS (Godot 4.7)
config_version=5

[application]

config/name="Opération Aube"
config/description="Prototype de FPS solo — Normandie, juin 1944 (low-poly)"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Fx="*res://scripts/autoload/fx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="monde"
3d_physics/layer_2="joueur"
3d_physics/layer_3="ennemis"
3d_physics/layer_4="interaction"

[navigation]

3d/default_cell_size=0.25
3d/default_cell_height=0.25

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
